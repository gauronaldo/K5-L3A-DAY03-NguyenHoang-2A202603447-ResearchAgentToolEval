            "pdf_path": "C:\\Users\\84973\\Documents\\Day03-Prompt-Engineering-Tool-Calling-Labs-student\\starter_v0\\arxiv_papers\\1706.03762.pdf",
            "txt_path": "C:\\Users\\84973\\Documents\\Day03-Prompt-Engineering-Tool-Calling-Labs-student\\starter_v0\\arxiv_papers\\1706.03762.txt",
            "page_count": 15,
